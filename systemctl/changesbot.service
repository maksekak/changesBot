[Unit]
Description=ChangesBot — Telegram бот расписания колледжа
After=network.target

[Service]
Type=simple
User=changesbot
WorkingDirectory=/opt/changesBot
ExecStartPre=/usr/bin/test -f /opt/changesBot/.env
ExecStart=/opt/changesBot/changesBotBuild
Restart=always
RestartSec=10
EnvironmentFile=/opt/changesBot/.env

# Логи выводятся в journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
